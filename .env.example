# Nullp works with no key at all, using a local model via Ollama.
# Add an Anthropic key here to switch to Claude - it is preferred when present.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# NULLP_MODEL=claude-opus-5          # which Claude model, when a key is set
# NULLP_LOCAL_MODEL=llama3.2:3b      # which local model, when there is no key
# OLLAMA_URL=http://localhost:11434
# PORT=4173
